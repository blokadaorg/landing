{%- set s = t[lang] -%}
{%- set canonical = site.origin + page.url -%}
{%- set alts = collections.all | alternates(key) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Blokada</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- for alt in alts %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.origin }}{{ alt.url }}">
  {%- endfor %}
  {%- for alt in alts %}{% if alt.lang == 'en' %}
  <link rel="alternate" hreflang="x-default" href="{{ site.origin }}{{ alt.url }}">
  {%- endif %}{% endfor %}
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Blokada">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.origin }}/img/blokada-thumb.png">
  <meta property="og:locale" content="{{ lang }}">
  {#- Discourse identifies the embedding page by its Referer. #}
  <meta name="referrer" content="no-referrer-when-downgrade">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/guides/assets/guides.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><img src="/img/brand/blue.png" alt="Blokada" height="32"></a>
      <nav>
        <a href="{{ site.prefix[lang] }}/guides/">{{ s.guides }}</a>
        <a href="{{ site.dashboard }}/?src=guides">{{ s.dashboard }}</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      {%- if alts.length > 1 %}
      <nav class="languages" aria-label="{{ s.otherLanguages }}">
        {%- for alt in alts %}
        {%- if alt.lang == lang %}
        <span aria-current="page">{{ t[alt.lang].languageName }}</span>
        {%- else %}
        <a href="{{ alt.url }}" hreflang="{{ alt.lang }}" lang="{{ alt.lang }}">{{ t[alt.lang].languageName }}</a>
        {%- endif %}
        {%- endfor %}
      </nav>
      {%- endif %}
      <p>
        &copy; Blocka AB ·
        <a href="https://go.blokada.org/terms">{{ s.terms }}</a> ·
        <a href="https://go.blokada.org/privacy">{{ s.privacy }}</a>
      </p>
    </div>
  </footer>
</body>
</html>
