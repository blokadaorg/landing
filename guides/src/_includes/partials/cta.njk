{%- set s = t[lang] -%}
<aside class="cta">
  <h2>{{ s.ctaTitle }}</h2>
  <p>{{ s.ctaText }}</p>
  <p class="actions">
    <a class="btn btn-primary" href="{{ site.dashboard }}/activate?tier=cloud&amp;src=guides">{{ s.ctaBuy }}</a>
    <a class="btn btn-white" href="{{ site.dashboard }}/setup?src=guides">{{ s.ctaHave }}</a>
  </p>
  <p class="small">{{ s.plusNote | replace("{dashboard}", site.dashboard) | safe }}</p>
</aside>
