{#- Comments come from the forum and need JavaScript; the guide above does not.
    The forum styles the frame itself: className lands on the frame's <html>,
    and the forum theme's Embedded CSS (guides/discourse-embedded.css) keys on
    it, including which of our themes the page is showing. #}
<div id="discourse-comments"></div>
<script>
  (function () {
    function theme() {
      var chosen = document.documentElement.getAttribute('data-theme');
      if (chosen) return chosen;
      return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    function className(t) {
      return 'blokada-guides theme-' + t;
    }

    window.DiscourseEmbed = {
      discourseUrl: '{{ site.forum }}',
      discourseEmbedUrl: '{{ site.origin }}{{ page.url }}',
      className: className(theme()),
    };

    // The frame can't be restyled from here, so a theme change reloads it
    // with the other class. It is one small request, and only on a toggle.
    document.addEventListener('blokada:theme', function () {
      var frame = document.getElementById('discourse-embed-frame');
      if (!frame) return;
      var src = frame.src.replace(/([?&]class_name=)[^&]*/, '$1' + encodeURIComponent(className(theme())));
      if (src !== frame.src) frame.src = src;
    });

    var d = document.createElement('script');
    d.async = true;
    d.src = window.DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
    document.head.appendChild(d);
  })();
</script>
