<section id="opinions" class="section section-lg pt-lg-0 mt-4">
<div class="container">
<h2 class="sr-only">{{ 'homepage action opinions' | tr }}</h2>
<div class="row justify-content-center text-center mb-lg">
<div class="col-lg-8">
<p class="lead text-muted">{{ 'homepage community opinions' | tr }}<br>
<a href="https://go.blokada.org/opinions?src=landing" class="text-warning">{{ 'universal action learn more' | tr }}</a>
</p>
</div>
</div>
<div class="row justify-content-center">
<div class="col-lg-12">
<div class="row row-grid">
{%- for review in site.reviews %}
<div class="col-lg-4" data-review{% if loop.index > 3 %} hidden{% endif %}>
<div class="card border-0 card-lift--hover shadow">
<div class="card-body py-3">
<p class="mt-4">
<span class="text-warning">{% icon "solid-star" %}</span>
<span class="text-warning">{% icon "solid-star" %}</span>
<span class="text-warning">{% icon "solid-star" %}</span>
<span class="text-warning">{% icon "solid-star" %}</span>
<span class="text-warning">{% icon "solid-star" %}</span>
</p>
<p class="description mt-4">{{ review.text }}</p>
<p class="description text-muted">{{ review.name }}, {{ review.source }}</p>
</div>
</div>
</div>
{%- endfor %}
</div>
</div>
</div>
</div>
</section>
