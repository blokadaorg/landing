---
pagination:
  data: site.redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
eleventyExcludeFromCollections: true
---
{%- set target = (site.origin + redirect.to) if redirect.to.startsWith('/') else redirect.to -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Blokada</title>
<link rel="canonical" href="{{ target }}">
<meta http-equiv="refresh" content="0; url={{ target }}">
</head>
<body>
<p><a href="{{ target }}">{{ target }}</a></p>
</body>
</html>
